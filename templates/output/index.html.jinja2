<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'unsafe-inline'; script-src 'unsafe-inline'; img-src data:;">
  <title>CodeGuide - {{ repo_name | e }}</title>
  <style>
    :root {
      --bg: #0f172a;
      --surface: #1e293b;
      --surface-border: #334155;
      --text: #f8fafc;
      --text-muted: #94a3b8;
      --accent: #38bdf8;
      --accent-hover: #0284c7;
      --danger: #ef4444;
      --badge-bg: #0369a1;
      --code-bg: #090d16;
    }
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      background-color: var(--bg);
      color: var(--text);
      line-height: 1.5;
      height: 100vh;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }
    header {
      background-color: var(--surface);
      border-bottom: 1px solid var(--surface-border);
      padding: 0.75rem 1.5rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-shrink: 0;
    }
    .header-title {
      display: flex;
      align-items: center;
      gap: 1rem;
    }
    h1 {
      font-size: 1.25rem;
      font-weight: 600;
      color: var(--text);
    }
    .badge {
      font-size: 0.75rem;
      background: var(--badge-bg);
      color: var(--text);
      padding: 0.2rem 0.5rem;
      border-radius: 4px;
      font-weight: 500;
    }
    .search-box {
      width: 320px;
    }
    .search-box input {
      width: 100%;
      background: var(--bg);
      border: 1px solid var(--surface-border);
      color: var(--text);
      padding: 0.4rem 0.75rem;
      border-radius: 4px;
      font-size: 0.875rem;
    }
    .search-box input:focus {
      outline: 1px solid var(--accent);
      border-color: var(--accent);
    }
    main {
      flex: 1;
      display: grid;
      grid-template-columns: 320px 1fr 380px;
      overflow: hidden;
    }
    .panel {
      display: flex;
      flex-direction: column;
      border-right: 1px solid var(--surface-border);
      overflow: hidden;
      background: var(--surface);
    }
    .panel-header {
      padding: 0.75rem 1rem;
      border-bottom: 1px solid var(--surface-border);
      font-size: 0.875rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--text-muted);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .panel-content {
      flex: 1;
      overflow-y: auto;
      padding: 0.5rem;
    }
    .file-item {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0.35rem 0.6rem;
      border-radius: 4px;
      cursor: pointer;
      font-size: 0.8125rem;
      color: var(--text);
      user-select: none;
    }
    .file-item:hover {
      background: var(--surface-border);
    }
    .file-item.active {
      background: var(--badge-bg);
    }
    .file-name {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .file-meta {
      font-size: 0.75rem;
      color: var(--text-muted);
      margin-left: 0.5rem;
      flex-shrink: 0;
    }
    .module-card {
      background: var(--bg);
      border: 1px solid var(--surface-border);
      border-radius: 6px;
      padding: 1rem;
      margin-bottom: 1rem;
    }
    .module-header {
      font-size: 1rem;
      font-weight: 600;
      color: var(--accent);
      margin-bottom: 0.5rem;
      display: flex;
      justify-content: space-between;
    }
    .module-citation {
      font-size: 0.75rem;
      color: var(--text-muted);
      font-family: monospace;
    }
    .module-desc {
      font-size: 0.875rem;
      margin-bottom: 0.75rem;
      color: var(--text);
    }
    .symbol-list {
      display: flex;
      flex-wrap: wrap;
      gap: 0.35rem;
      margin-top: 0.5rem;
    }
    .symbol-chip {
      background: var(--surface);
      border: 1px solid var(--surface-border);
      padding: 0.15rem 0.4rem;
      border-radius: 3px;
      font-family: monospace;
      font-size: 0.75rem;
      color: var(--text-muted);
    }
    .graph-view {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }
    .graph-node {
      background: var(--bg);
      border: 1px solid var(--surface-border);
      border-radius: 4px;
      padding: 0.75rem;
    }
    .graph-node-title {
      font-weight: 600;
      font-size: 0.875rem;
      color: var(--accent);
      margin-bottom: 0.35rem;
    }
    .edge-list {
      font-size: 0.75rem;
      color: var(--text-muted);
      list-style-type: none;
    }
    .edge-list li {
      padding: 0.15rem 0;
    }
    .circular-badge {
      background: var(--danger);
      color: white;
      font-size: 0.7rem;
      padding: 0.1rem 0.3rem;
      border-radius: 3px;
      margin-left: 0.5rem;
    }
  </style>
</head>
<body>
  <header>
    <div class="header-title">
      <h1>CodeGuide: {{ repo_name | e }}</h1>
      <span class="badge">{{ architecture_name | e }}</span>
    </div>
    <div class="search-box">
      <input type="text" id="filter-input" placeholder="Search files, symbols, modules..." aria-label="Search repository">
    </div>
  </header>

  <main>
    <section class="panel" aria-label="File Tree">
      <div class="panel-header">
        <span>Files</span>
        <span id="file-count">0</span>
      </div>
      <div class="panel-content" id="tree-container"></div>
    </section>

    <section class="panel" aria-label="Module Summaries" style="border-right: 1px solid var(--surface-border);">
      <div class="panel-header">
        <span>Module Breakdown</span>
        <span id="module-count">0</span>
      </div>
      <div class="panel-content" id="modules-container"></div>
    </section>

    <section class="panel" aria-label="Dependency Graph" style="border-right: none;">
      <div class="panel-header">
        <span>Dependencies</span>
        <span id="graph-count">0</span>
      </div>
      <div class="panel-content" id="graph-container"></div>
    </section>
  </main>

  <script type="application/json" id="repo-data">{{ safe_json_data }}</script>

  <script>
    (function() {
      'use strict';

      var dataScript = document.getElementById('repo-data');
      if (!dataScript) return;

      var repoData;
      try {
        repoData = JSON.parse(dataScript.textContent || '{}');
      } catch (e) {
        return;
      }

      var treeContainer = document.getElementById('tree-container');
      var modulesContainer = document.getElementById('modules-container');
      var graphContainer = document.getElementById('graph-container');
      var filterInput = document.getElementById('filter-input');
      var fileCountEl = document.getElementById('file-count');
      var moduleCountEl = document.getElementById('module-count');
      var graphCountEl = document.getElementById('graph-count');

      var files = repoData.files || [];
      var modules = repoData.modules || [];
      var graph = repoData.graph || { nodes: [], edges: [], circular: [] };

      function renderTree(filterText) {
        while (treeContainer.firstChild) {
          treeContainer.removeChild(treeContainer.firstChild);
        }
        var count = 0;
        var lowerFilter = (filterText || '').toLowerCase();

        for (var i = 0; i < files.length; i++) {
          var f = files[i];
          if (lowerFilter && f.path.toLowerCase().indexOf(lowerFilter) === -1) {
            continue;
          }
          count++;

          var item = document.createElement('div');
          item.className = 'file-item';
          item.dataset.path = f.path;

          var nameSpan = document.createElement('span');
          nameSpan.className = 'file-name';
          nameSpan.textContent = f.path;

          var metaSpan = document.createElement('span');
          metaSpan.className = 'file-meta';
          metaSpan.textContent = (f.lines || 0) + 'L';

          item.appendChild(nameSpan);
          item.appendChild(metaSpan);

          (function(filePath) {
            item.addEventListener('click', function() {
              filterInput.value = filePath;
              renderModules(filePath);
            });
          })(f.path);

          treeContainer.appendChild(item);
        }
        fileCountEl.textContent = String(count);
      }

      function renderModules(filterText) {
        while (modulesContainer.firstChild) {
          modulesContainer.removeChild(modulesContainer.firstChild);
        }
        var count = 0;
        var lowerFilter = (filterText || '').toLowerCase();

        for (var i = 0; i < modules.length; i++) {
          var m = modules[i];
          var matchPath = m.path.toLowerCase().indexOf(lowerFilter) !== -1;
          var matchDesc = (m.responsibility || '').toLowerCase().indexOf(lowerFilter) !== -1;
          var matchSymbols = false;
          if (m.symbols) {
            for (var s = 0; s < m.symbols.length; s++) {
              if (m.symbols[s].toLowerCase().indexOf(lowerFilter) !== -1) {
                matchSymbols = true;
                break;
              }
            }
          }

          if (lowerFilter && !matchPath && !matchDesc && !matchSymbols) {
            continue;
          }
          count++;

          var card = document.createElement('div');
          card.className = 'module-card';

          var header = document.createElement('div');
          header.className = 'module-header';

          var title = document.createElement('span');
          title.textContent = m.path;

          var citation = document.createElement('span');
          citation.className = 'module-citation';
          citation.textContent = m.citation || 'unclear';

          header.appendChild(title);
          header.appendChild(citation);
          card.appendChild(header);

          var desc = document.createElement('div');
          desc.className = 'module-desc';
          desc.textContent = m.responsibility || 'No responsibility documented.';
          card.appendChild(desc);

          if (m.symbols && m.symbols.length > 0) {
            var symList = document.createElement('div');
            symList.className = 'symbol-list';
            for (var j = 0; j < m.symbols.length; j++) {
              var chip = document.createElement('span');
              chip.className = 'symbol-chip';
              chip.textContent = m.symbols[j];
              symList.appendChild(chip);
            }
            card.appendChild(symList);
          }

          modulesContainer.appendChild(card);
        }
        moduleCountEl.textContent = String(count);
      }

      function renderGraph(filterText) {
        while (graphContainer.firstChild) {
          graphContainer.removeChild(graphContainer.firstChild);
        }
        var lowerFilter = (filterText || '').toLowerCase();
        var nodes = graph.nodes || [];
        var edges = graph.edges || [];
        var circular = graph.circular || [];
        var circularSet = {};
        for (var c = 0; c < circular.length; c++) {
          circularSet[circular[c]] = true;
        }

        var count = 0;
        for (var i = 0; i < nodes.length; i++) {
          var node = nodes[i];
          if (lowerFilter && node.toLowerCase().indexOf(lowerFilter) === -1) {
            continue;
          }
          count++;

          var nodeCard = document.createElement('div');
          nodeCard.className = 'graph-node';

          var titleEl = document.createElement('div');
          titleEl.className = 'graph-node-title';
          titleEl.textContent = node;

          if (circularSet[node]) {
            var circBadge = document.createElement('span');
            circBadge.className = 'circular-badge';
            circBadge.textContent = 'Circular';
            titleEl.appendChild(circBadge);
          }
          nodeCard.appendChild(titleEl);

          var depList = document.createElement('ul');
          depList.className = 'edge-list';
          var hasEdges = false;

          for (var e = 0; e < edges.length; e++) {
            if (edges[e].source === node) {
              hasEdges = true;
              var li = document.createElement('li');
              li.textContent = '-> ' + edges[e].target;
              depList.appendChild(li);
            }
          }

          if (!hasEdges) {
            var leafLi = document.createElement('li');
            leafLi.textContent = '(no outbound internal imports)';
            depList.appendChild(leafLi);
          }

          nodeCard.appendChild(depList);
          graphContainer.appendChild(nodeCard);
        }
        graphCountEl.textContent = String(count);
      }

      function updateAll() {
        var query = filterInput.value.trim();
        renderTree(query);
        renderModules(query);
        renderGraph(query);
      }

      filterInput.addEventListener('input', updateAll);
      updateAll();
    })();
  </script>
</body>
</html>

